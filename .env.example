# RivetLink Relay Server — environment configuration
#
# Run ./install.sh --domain relay.example.com --email you@example.com
# and it writes `.env` from this template with strong random secrets.
#
# DO NOT commit `.env` — it contains your JWT signing secret and DB password.

# ── Public address ──────────────────────────────────────────────────────────
# Hostname whose DNS A/AAAA record points at this server.
DOMAIN=relay.example.com
# Contact for Let's Encrypt (expiry warnings only).
ACME_EMAIL=

# ── Required secrets (install.sh generates these) ───────────────────────────
# Postgres password. Used by the postgres container AND woven into DATABASE_URL.
# Never change it after the first start: the database keeps the old one.
POSTGRES_PASSWORD=

# JWT signing secret. MUST be at least 32 characters. 256-bit base64 recommended:
#   openssl rand -base64 32
JWT_SECRET=

# ── Relay image ─────────────────────────────────────────────────────────────
# Pinned so an update is a deliberate change you can roll back. Relay tunnels
# (remote console) need 0.1.105 or newer.
RELAY_IMAGE=gtheunissen/rivetlink-relay:0.1.111
# Log level: error | warn | info | debug | trace
RUST_LOG=info

# ── Direct connections (--profile turn) ─────────────────────────────────────
# Shared secret for coturn's time-limited credentials. ./install.sh --with-turn
# generates it and renders coturn/turnserver.local.conf from it.
TURN_SECRET=
# host:port of the STUN server the apps use to find a direct path, e.g.
# relay.example.com:3478. ./install.sh --with-turn sets it. Empty: relay only.
STUN_SERVER=

# ── Backups (scripts/backup.sh) ─────────────────────────────────────────────
# Days local dumps in backups/ are kept.
BACKUP_RETENTION_DAYS=14
# Optional offsite copy: rsync/scp target, e.g. user@backuphost:rivetlink-backups/
# (needs an ssh key without a passphrase prompt). Empty: local only.
BACKUP_REMOTE=

# ── Token / security tunables (sensible defaults; change only if you know why)
ACCESS_TOKEN_EXPIRY_SECS=900
REFRESH_TOKEN_EXPIRY_SECS=604800
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_SECS=900
HEARTBEAT_INTERVAL_SECS=10
DISCONNECT_TIMEOUT_SECS=30
RECONNECT_GRACE_SECS=15
