# RivetLink Relay Server — environment configuration
#
# Copy this file to `.env` and fill in the secrets, OR just run ./install.sh
# which generates a `.env` with strong random secrets for you.
#
# DO NOT commit `.env` — it contains your JWT signing secret and DB password.

# ── Required secrets (install.sh generates these) ───────────────────────────
# Postgres password. Used by the postgres container AND woven into DATABASE_URL.
POSTGRES_PASSWORD=

# JWT signing secret. MUST be at least 32 characters. 256-bit base64 recommended:
#   openssl rand -base64 32
JWT_SECRET=

# ── Relay image & port ──────────────────────────────────────────────────────
# Published image. Override with a locally built tag for testing.
RELAY_IMAGE=gtheunissen/rivetlink-relay:latest
# Host port the relay listens on (plain HTTP). Ignored if you front it with nginx.
RELAY_PORT=8080
# Log level: error | warn | info | debug | trace
RUST_LOG=info

# ── TLS profile (--profile tls) ─────────────────────────────────────────────
# Public hostname clients connect to. Required only for the tls/nginx profile.
DOMAIN=relay.example.com

# ── Token / security tunables (sensible defaults; change only if you know why)
ACCESS_TOKEN_EXPIRY_SECS=900
REFRESH_TOKEN_EXPIRY_SECS=604800
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_SECS=900
HEARTBEAT_INTERVAL_SECS=10
DISCONNECT_TIMEOUT_SECS=30
RECONNECT_GRACE_SECS=15
